# SUSHI Tool — Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# SAP Connection (production only — sanitized in this repo)
# SAP_RFC_HOST=your_sap_host
# SAP_RFC_SYSNR=00
# SAP_RFC_CLIENT=100
# SAP_RFC_USER=your_sap_user
# SAP_RFC_PASSWORD=your_sap_password
